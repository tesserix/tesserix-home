# Build stage
FROM node:22-alpine AS builder

WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10.17.1 --activate

# Copy workspace manifests + lockfile first for cached, deterministic installs
COPY pnpm-workspace.yaml pnpm-lock.yaml .npmrc package.json ./
COPY apps/console/package.json apps/console/package.json
COPY packages/console-core/package.json packages/console-core/package.json
COPY packages/crm-country/package.json packages/crm-country/package.json
COPY packages/platform-auth/package.json packages/platform-auth/package.json
COPY packages/tsconfig/package.json packages/tsconfig/package.json
COPY packages/eslint-config/package.json packages/eslint-config/package.json

# Install only what the console app needs (skips web/mobile toolchains).
# @tesserix/* deps now resolve from the public npm registry (see .npmrc), so
# no auth token is required here.
RUN pnpm install --frozen-lockfile --filter console...

# Copy sources and build the console app
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1
# Build order matters and is NOT alphabetical: console-core type-imports
# `Capability` from platform-auth (packages/console-core/src/routes.ts), so its
# dts build needs platform-auth's declarations to already exist. Building
# console-core first fails with TS2307, which is what broke every console image
# from #200 until this line was fixed.
#
# `turbo run build` would derive this from the dependency graph rather than
# hardcoding it here, which is why the root `pnpm build` never reproduced the
# failure — only this Dockerfile pins an order. Worth moving to turbo the next
# time this file is touched.
RUN pnpm --filter @tesserix/platform-auth build && pnpm --filter @tesserix/console-core build && pnpm --filter console build

# The plan-catalog parity CronJob's entry point (#326 P1a), bundled by esbuild
# to a single plain-JS module.
#
# Next's standalone output contains ONLY what the server needs, so
# `apps/console/scripts/parity-check.ts` is not in the runtime image and the
# CronJob cannot `node` a source file.
#
# `pg` is left external because it IS in the standalone output's node_modules
# (Next externalises it by default). `stripe` is NOT — Next inlines it into the
# route's server chunk and traces no package — so the bundle inlines it too.
# Getting that backwards produces an image that builds green here and fails in
# the cluster with `Cannot find package 'stripe'`.
RUN pnpm --filter console build:cron

# The startup schema preflight (#610 follow-up), and the version file it reads.
#
# Same packaging as build:cron above and for the same reason — the standalone
# output has no TypeScript in it — so the same external/inline rule applies:
# `pg` stays external because it IS in the standalone node_modules. This bundle
# touches no Stripe SDK, so there is nothing to inline.
#
# `build:schema-version` walks `apps/web/db/migrations/` and writes the list of
# versions THIS SOURCE TREE ships into dist/schema-version.json. It runs here,
# in the builder, because the answer is a property of the image and must not be
# something a deployer can set — see the script's header. It fails the build if
# it finds no migrations, rather than emitting an empty list that would make the
# preflight pass against any database at all.
RUN pnpm --filter console build:preflight && pnpm --filter console build:schema-version

# Production stage
FROM node:22-alpine AS runner

WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Non-root user
RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# Standalone bundle (contains apps/console/server.js + hoisted node_modules)
COPY --from=builder --chown=nextjs:nodejs /app/apps/console/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/console/.next/static ./apps/console/.next/static
# `public/` is NOT part of the standalone output — Next expects it copied
# alongside, exactly as the web Dockerfile does. Omitting this used to be
# harmless because apps/console/public was empty; it stopped being harmless the
# moment the sidebar logos landed there, and the failure is a silent 404 on an
# image rather than anything that fails a build.
COPY --from=builder --chown=nextjs:nodejs /app/apps/console/public ./apps/console/public
# The parity CronJob's bundle. Placed INSIDE the standalone tree on purpose:
# `pg` and `stripe` are external to it, so Node has to find them by walking up
# from the file — which reaches this image's hoisted /app/node_modules only
# from here. The CronJob in `tesserix-k8s` overrides `command` to run it.
COPY --from=builder --chown=nextjs:nodejs /app/apps/console/dist/parity-check.mjs ./apps/console/scripts/parity-check.mjs
# The startup preflight and its baked version list. INSIDE the standalone tree
# for the same reason the parity bundle is — `pg` is external to it, so Node
# finds the driver only by walking up from here to /app/node_modules — and the
# two files must land in the SAME directory, because the bundle resolves the
# JSON relative to its own `import.meta.url` rather than the working directory.
COPY --from=builder --chown=nextjs:nodejs /app/apps/console/dist/require-schema-version.mjs ./apps/console/scripts/require-schema-version.mjs
COPY --from=builder --chown=nextjs:nodejs /app/apps/console/dist/schema-version.json ./apps/console/scripts/schema-version.json

USER nextjs
EXPOSE 3000
ENV HOSTNAME="0.0.0.0"
ENV PORT=3000

# The preflight runs FIRST and the server only if it succeeds.
#
# Migrations here are applied by hand while Kargo deploys on merge, so an image
# can reach the cluster before the schema it needs does. The preflight compares
# the versions baked in above against the database's `schema_migrations` ledger
# and exits non-zero if any are missing, so the port never opens — which, at
# `maxSurge: 0, maxUnavailable: 1` across 2 replicas, halts the rollout with an
# old replica (the one the current schema actually matches) still serving. The
# readiness probe is `tcpSocket` and is unchanged; this composes with it rather
# than replacing it, and adds no HTTP surface.
#
# `exec` ON THE SERVER, so Node REPLACES the shell and is PID 1 for the entire
# life of the container that matters — only the short-lived preflight runs
# under the shell. Without PID 1, SIGTERM at the end of a rollout would reach
# the shell and not the process that has to drain, and the pod would sit until
# `terminationGracePeriodSeconds` and get SIGKILLed.
#
# MEASURED, not assumed, on node:22-alpine: ash already applies its own
# implicit exec to the last command of `A && B`, so dropping the keyword
# happens to behave identically TODAY. That is a shell optimisation, not a
# contract — it does not hold once anything is appended after the server, and
# it is not something a future editor of this line should have to know. The
# keyword makes the guarantee explicit and costs nothing.
#
# Verified with `docker stop -t 10`: `ps` inside the container reports
# `1 node apps/console/server.js`, the process logs its SIGTERM handler, and
# the container stops in 0s rather than at the grace deadline.
#
# `&&` and not `;` — a preflight that fails must stop the container, not be
# logged and stepped over.
CMD ["/bin/sh", "-c", "node apps/console/scripts/require-schema-version.mjs && exec node apps/console/server.js"]
