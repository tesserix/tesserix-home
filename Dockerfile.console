# Build stage
FROM node:22-alpine AS builder

WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10.17.1 --activate

# Copy workspace manifests + lockfile first for cached, deterministic installs
COPY pnpm-workspace.yaml pnpm-lock.yaml .npmrc package.json ./
COPY apps/console/package.json apps/console/package.json
COPY packages/console-core/package.json packages/console-core/package.json
COPY packages/crm-country/package.json packages/crm-country/package.json
COPY packages/platform-auth/package.json packages/platform-auth/package.json
COPY packages/tsconfig/package.json packages/tsconfig/package.json
COPY packages/eslint-config/package.json packages/eslint-config/package.json

# Install only what the console app needs (skips web/mobile toolchains).
# @tesserix/* deps now resolve from the public npm registry (see .npmrc), so
# no auth token is required here.
RUN pnpm install --frozen-lockfile --filter console...

# Copy sources and build the console app
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1
# Build order matters and is NOT alphabetical: console-core type-imports
# `Capability` from platform-auth (packages/console-core/src/routes.ts), so its
# dts build needs platform-auth's declarations to already exist. Building
# console-core first fails with TS2307, which is what broke every console image
# from #200 until this line was fixed.
#
# `turbo run build` would derive this from the dependency graph rather than
# hardcoding it here, which is why the root `pnpm build` never reproduced the
# failure — only this Dockerfile pins an order. Worth moving to turbo the next
# time this file is touched.
RUN pnpm --filter @tesserix/platform-auth build && pnpm --filter @tesserix/console-core build && pnpm --filter console build

# The plan-catalog parity CronJob's entry point (#326 P1a), bundled by esbuild
# to a single plain-JS module.
#
# Next's standalone output contains ONLY what the server needs, so
# `apps/console/scripts/parity-check.ts` is not in the runtime image and the
# CronJob cannot `node` a source file.
#
# `pg` is left external because it IS in the standalone output's node_modules
# (Next externalises it by default). `stripe` is NOT — Next inlines it into the
# route's server chunk and traces no package — so the bundle inlines it too.
# Getting that backwards produces an image that builds green here and fails in
# the cluster with `Cannot find package 'stripe'`.
RUN pnpm --filter console build:cron

# Production stage
FROM node:22-alpine AS runner

WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Non-root user
RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# Standalone bundle (contains apps/console/server.js + hoisted node_modules)
COPY --from=builder --chown=nextjs:nodejs /app/apps/console/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/console/.next/static ./apps/console/.next/static
# `public/` is NOT part of the standalone output — Next expects it copied
# alongside, exactly as the web Dockerfile does. Omitting this used to be
# harmless because apps/console/public was empty; it stopped being harmless the
# moment the sidebar logos landed there, and the failure is a silent 404 on an
# image rather than anything that fails a build.
COPY --from=builder --chown=nextjs:nodejs /app/apps/console/public ./apps/console/public
# The parity CronJob's bundle. Placed INSIDE the standalone tree on purpose:
# `pg` and `stripe` are external to it, so Node has to find them by walking up
# from the file — which reaches this image's hoisted /app/node_modules only
# from here. The CronJob in `tesserix-k8s` overrides `command` to run it.
COPY --from=builder --chown=nextjs:nodejs /app/apps/console/dist/parity-check.mjs ./apps/console/scripts/parity-check.mjs

USER nextjs
EXPOSE 3000
ENV HOSTNAME="0.0.0.0"
ENV PORT=3000

CMD ["node", "apps/console/server.js"]
