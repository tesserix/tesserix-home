{
  "name": "@tesserix/console-core",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "node ../../scripts/require-workspace-dist.mjs && tsup",
    "dev": "tsup --watch",
    "lint": "eslint --max-warnings 0",
    "typecheck": "node ../../scripts/require-workspace-dist.mjs && tsc --noEmit",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@tesserix/platform-auth": "workspace:*"
  },
  "devDependencies": {
    "@tesserix/eslint-config": "workspace:*",
    "@tesserix/tsconfig": "workspace:*",
    "eslint": "^9",
    "tsup": "^8.5.0",
    "typescript": "5.9.3",
    "vitest": "^3.2.4"
  }
}
