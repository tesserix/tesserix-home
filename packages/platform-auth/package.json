  },
  "dependencies": {
    "jose": "^6.2.3"
  },
  "devDependencies": {
    "@tesserix/tsconfig": "workspace:*",
    "next": "^16.2.6",
    "tsup": "^8.5.0",
    "typescript": "5.9.3",
    "vitest": "^3.2.4"
  }
}
