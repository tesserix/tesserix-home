node-linker=hoisted
shamefully-hoist=true

# @tesserix packages resolve from the PUBLIC npm registry, not GitHub Packages.
#
# They were already published to both. Verified 2026-08-05 that the npmjs
# tarballs are the SAME ARTIFACTS, by comparing this lockfile's recorded
# integrity against registry.npmjs.org — @tesserix/web@1.7.1,
# @tesserix/hooks@1.0.0 and @tesserix/otto-widget@0.6.0 all matched byte for
# byte. So this is a registry swap, not a version change.
#
# Why it matters: npm.pkg.github.com requires an authenticated token for private
# packages, which made every build — CI, Docker, and any developer's laptop —
# depend on the PKG_READ_TOKEN secret. It also made this repo unbuildable if it
# were ever made public, because GitHub will not serve a private package to a
# public repository's workflow no matter what token is presented (a fork could
# then read it). Nothing here needs authentication now.
