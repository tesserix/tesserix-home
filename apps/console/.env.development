# Local development for the console (#271, ADR-003 D6).
#
# COMMITTED ON PURPOSE, and safe to commit: every value here points at the
# throwaway Postgres in docker-compose.dev.yml and at the local admin-API stub.
# There is no production credential in this file and none should ever be added
# — .env.local and .env*.local are gitignored and exist for that.
#
# Next.js loads this automatically for `next dev`. The node scripts read it
# explicitly with `node --env-file=.env.development`.

# --- the dev database (docker-compose.dev.yml) ---------------------------
# Port 55432, not 5432, so this cannot collide with — or silently connect to —
# a Postgres already running on the machine.
TESSERIX_DB_HOST=localhost
TESSERIX_DB_PORT=55432
TESSERIX_DB_NAME=tesserix_admin
TESSERIX_DB_USER=tesserix
# The dev database uses trust auth (see docker-compose.dev.yml), so the server
# accepts any value here. A value is still required because the console's
# isDatabaseConfigured() and db-migrate both demand one — and weakening those
# production guards to suit local development would be the wrong trade. Named
# so nobody mistakes it for a credential.
TESSERIX_DB_PASSWORD=unused-under-trust-auth
# A plain local Postgres speaks no TLS and refuses the negotiation. In the
# cluster this is unset, so TLS stays on (unverified — CNPG self-signs).
TESSERIX_DB_SSLMODE=disable

# --- the admin API stub (dev/admin-stub.mjs) -----------------------------
# The console reads this name verbatim (lib/platform-api.ts). Pointing it at
# the stub is what lets the dashboard, tickets, support-analytics and audit
# surfaces render without running apps/web.
WEB_INTERNAL_ORIGIN=http://localhost:3002

# --- CRM erasure (#226) --------------------------------------------------
# Keys the HMAC that lets an import recognise — and refuse — someone who asked
# to be forgotten, without retaining their email or handle to compare against.
# `eraseContact` FAILS CLOSED without it, so local development would otherwise
# have a "forget me" button that always errors.
#
# Safe to commit for the same reason as everything above: it only ever keys
# hashes in the throwaway docker-compose database. The production value is a
# real secret and lives in GCP Secret Manager, mapped in via ExternalSecret —
# never here. Changing this value locally invalidates every hash already
# recorded against the old one, which is also true in production and is why
# rotating it is not a routine operation.
CRM_ERASURE_HASH_KEY=local-dev-only-not-a-secret

# --- auth ----------------------------------------------------------------
# Skips the Zitadel round trip so local surfaces are reachable at all. The
# middleware THROWS at startup under NODE_ENV=production, so this cannot leak
# into a deployment — that guard is what makes committing this safe.
NEXT_PUBLIC_DEV_AUTH_BYPASS=true
