{
  "name": "console",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3003",
    "dev:stub": "node --env-file=.env.development dev/admin-stub.mjs",
    "dev:db:up": "docker compose -f ../../docker-compose.dev.yml up -d --wait",
    "dev:db:migrate": "node --env-file=.env.development ../web/scripts/db-migrate.mjs",
    "dev:db:seed": "node --env-file=.env.development scripts/seed-dev.mjs",
    "dev:db:reset": "npm run dev:db:up && npm run dev:db:migrate && npm run dev:db:seed",
    "dev:all": "npm run dev:db:up && concurrently -n stub,console -c magenta,cyan \"npm:dev:stub\" \"npm:dev\"",
    "build": "next build",
    "build:cron": "esbuild scripts/parity-check.ts --bundle --platform=node --format=esm --target=node22 --conditions=react-server --alias:@=. --external:pg --outfile=dist/parity-check.mjs",
    "build:bootstrap": "esbuild scripts/catalog-bootstrap.ts --bundle --platform=node --format=esm --target=node22 --conditions=react-server --alias:@=. --external:pg --outfile=dist/catalog-bootstrap.mjs",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@tesserix/console-core": "workspace:*",
    "@tesserix/crm-country": "workspace:*",
    "@tesserix/platform-auth": "workspace:*",
    "@tesserix/web": "^2.3.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.561.0",
    "next": "^16.2.6",
    "pg": "^8.22.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "server-only": "^0.0.1",
    "stripe": "^22.5.0",
    "swr": "^2.4.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "^4",
    "@tesserix/eslint-config": "workspace:*",
    "@tesserix/tsconfig": "workspace:*",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.1.2",
    "esbuild": "^0.28.1",
    "eslint": "^9",
    "eslint-config-next": "16.0.10",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  }
}
