{
  "cli": {
    "version": ">= 18.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "local-sim": {
      "developmentClient": false,
      "distribution": "internal",
      "ios": {
        "resourceClass": "m-medium",
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_API_BASE": "http://localhost:3002",
        "EXPO_PUBLIC_DEV_AUTH_BYPASS": "true"
      }
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE": "http://localhost:3002",
        "EXPO_PUBLIC_DEV_AUTH_BYPASS": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "ios": {
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE": "https://tesserix.app",
        "EXPO_PUBLIC_DEV_AUTH_BYPASS": "false",
        "EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID": "849928263410-rbk6kuskqgurberff8ppl5enqdn9b0ph.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "849928263410-eq63i2v34j61mbaghf0opu9fubmrkqua.apps.googleusercontent.com"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "ios": {
        "resourceClass": "m-medium"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE": "https://tesserix.app",
        "EXPO_PUBLIC_DEV_AUTH_BYPASS": "false",
        "EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID": "849928263410-rbk6kuskqgurberff8ppl5enqdn9b0ph.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "849928263410-eq63i2v34j61mbaghf0opu9fubmrkqua.apps.googleusercontent.com"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleTeamId": "2CRHRRYBPL",
        "ascAppId": "REPLACE_WITH_ADMIN_ASC_APP_ID"
      },
      "android": {
        "track": "internal",
        "releaseStatus": "completed"
