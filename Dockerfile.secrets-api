FROM golang:1.26-alpine AS builder
WORKDIR /src

# Both modules, as siblings. secrets-api's go.mod carries
# `replace ... => ../platform-auth`, a relative path, so the layout inside the
# image has to match the layout in the repository. Manifests first, so a
# source-only change does not re-download modules.
COPY platform-auth/go.mod platform-auth/go.sum ./platform-auth/
COPY secrets-api/go.mod secrets-api/go.sum ./secrets-api/
WORKDIR /src/secrets-api
RUN go mod download

COPY platform-auth/ /src/platform-auth/
COPY secrets-api/ /src/secrets-api/
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -trimpath -ldflags="-s -w -buildid=" -o /out/server ./cmd/server

FROM gcr.io/distroless/static-debian12:nonroot
WORKDIR /app
COPY --from=builder --chown=nonroot:nonroot /out/server /app/server
USER nonroot:nonroot
EXPOSE 8080
ENTRYPOINT ["/app/server"]
